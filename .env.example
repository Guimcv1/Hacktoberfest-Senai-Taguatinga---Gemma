# URL base do serviço de IA. Consumida apenas pelo backend.
AI_BASE_URL=https://bacteria-howto-rounds-that.trycloudflare.com

# Modelo confirmado pela equipe.
AI_MODEL=gemma3:4b

# Timeout das chamadas ao serviço de IA, em segundos.
# Modelos locais via túnel podem ser lentos.
AI_TIMEOUT_SECONDS=120

# Limite de upload de PDF, em megabytes.
MAX_PDF_SIZE_MB=10

# Persistência temporária em memória. Os dados se perdem ao reiniciar o processo.
DOCUMENT_TTL_MINUTES=30
MAX_STORED_DOCUMENTS=50
MAX_STORED_TEXT_CHARS=400000

# Limites do chat e da recuperação lexical.
MAX_CHAT_MESSAGE_CHARS=2000
MAX_RETRIEVAL_PAGES=3
MAX_CONTEXT_CHARS=6000
