# Gere um segredo exclusivo com pelo menos 32 caracteres.
JWT_SECRET=gere-um-segredo-aleatorio-com-32-caracteres-ou-mais

# Porta publicada somente pelo frontend/nginx.
APP_PORT=8080

# Banco PostgreSQL (acessível apenas dentro da rede Docker).
POSTGRES_USER=studybuddy
POSTGRES_PASSWORD=altere-esta-senha
POSTGRES_DB=studybuddy

# Configuração da aplicação.
ENVIRONMENT=production
LOG_LEVEL=INFO
JWT_EXPIRES_MINUTES=480
DB_AUTO_MIGRATE=true
CORS_ORIGINS=http://localhost:8080

# Ollama (acessível apenas pelo backend na rede Docker).
OLLAMA_IMAGE=ollama/ollama:0.40.11
AI_MODEL=gemma4:e4b
AI_TIMEOUT_SECONDS=120
OLLAMA_KEEP_ALIVE=120s

# Limites de documentos e chat.
DOCUMENT_TTL_MINUTES=10080
MAX_PDF_SIZE_MB=10
MAX_PDF_PAGES=50
MAX_STORED_DOCUMENTS=50
MAX_STORED_TEXT_CHARS=2000000
MAX_CHAT_MESSAGE_CHARS=2000
MAX_RETRIEVAL_PAGES=3
MAX_CONTEXT_CHARS=6000
RATE_LIMIT_PER_MINUTE=60
RATE_LIMIT_AUTH_PER_MINUTE=20
