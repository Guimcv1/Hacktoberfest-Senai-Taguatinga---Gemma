# Copie para .env no servidor. Não versione o arquivo .env.

# Obrigatório. 32+ caracteres, aleatório. Não use exemplos públicos.
JWT_SECRET=
JWT_EXPIRES_MINUTES=480

POSTGRES_USER=studybuddy
POSTGRES_PASSWORD=altere-esta-senha-localmente
POSTGRES_DB=studybuddy

PUBLISH_PORT=8080
CORS_ORIGINS=http://localhost:8080

AI_MODEL=gemma4:e4b
OLLAMA_KEEP_ALIVE=120s
AI_TIMEOUT_SECONDS=120
LOG_LEVEL=INFO

# Contextos de build. Padrão: branches no GitHub.
# Neste checkout da branch frontend:
# BACKEND_CONTEXT=https://github.com/Guimcv1/Hacktoberfest-Senai-Taguatinga---Gemma.git#backend
# FRONTEND_CONTEXT=./frontend
# OLLAMA_IMAGE=ollama/ollama:0.40.11
