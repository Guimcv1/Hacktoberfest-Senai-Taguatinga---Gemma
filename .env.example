# Ambiente: development | test | production
ENVIRONMENT=development

# Obrigatório. Segredo para assinar JWT: aleatório, exclusivo e com 32+ caracteres.
# Gere com: python -c "import secrets; print(secrets.token_urlsafe(48))"
# A API não inicia enquanto este valor estiver vazio.
JWT_SECRET=
JWT_EXPIRES_MINUTES=480

# Banco local (padrão). Para PostgreSQL:
# DATABASE_URL=postgresql+psycopg2://studybuddy:studybuddy@localhost:5432/studybuddy
DATABASE_URL=sqlite:///./data/studybuddy.db

# Origens permitidas no CORS, separadas por vírgula.
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173

# URL base do Ollama que executa o Gemma (somente backend; nunca envie ao frontend).
# Ex.: http://localhost:11434 ou a URL atual do túnel informada pela equipe de IA.
# Não versione a URL real: um Ollama sem autenticação fica aberto a quem a conhecer.
AI_BASE_URL=
AI_MODEL=gemma3:4b
AI_TIMEOUT_SECONDS=120

MAX_PDF_SIZE_MB=10
MAX_PDF_PAGES=50
DOCUMENT_TTL_MINUTES=30
MAX_STORED_DOCUMENTS=50
MAX_STORED_TEXT_CHARS=400000
MAX_CHAT_MESSAGE_CHARS=2000
MAX_RETRIEVAL_PAGES=3
MAX_CONTEXT_CHARS=6000
RATE_LIMIT_PER_MINUTE=60
