# ==========================================
# StudyBuddy AI - Variáveis de Ambiente
# ==========================================
# Copie este arquivo para .env na raiz do projeto antes de iniciar o Docker:
#   cp .env.example .env (Linux/macOS) ou Copy-Item .env.example .env (PowerShell)

# --- Segredos e Autenticação (Obrigatórios) ---
# Gere um segredo com 32+ caracteres:
# python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=coloque-aqui-uma-chave-secreta-com-pelo-menos-32-caracteres
JWT_EXPIRES_MINUTES=480

# --- Banco de Dados PostgreSQL ---
POSTGRES_USER=studybuddy
POSTGRES_PASSWORD=altere-esta-senha-em-producao
POSTGRES_DB=studybuddy
DB_AUTO_MIGRATE=true

# --- Portas e Rede ---
# Porta pública do Frontend / Nginx (única porta exposta ao host)
APP_PORT=8080

# Origens permitidas no CORS
CORS_ORIGINS=http://localhost:8080,http://127.0.0.1:8080,http://localhost:5173,http://127.0.0.1:5173

# --- Configurações Gerais do Backend ---
ENVIRONMENT=production
LOG_LEVEL=INFO

# --- Inteligência Artificial (Ollama) ---
OLLAMA_IMAGE=ollama/ollama:0.40.11
AI_MODEL=gemma4:e4b
AI_TIMEOUT_SECONDS=120
OLLAMA_KEEP_ALIVE=120s

# --- Limites de Documentos e Rate Limiting ---
DOCUMENT_STORAGE_DIR=/data/documents
DOCUMENT_TTL_MINUTES=10080
MAX_PDF_SIZE_MB=10
MAX_PDF_PAGES=50
MAX_STORED_DOCUMENTS=50
MAX_STORED_TEXT_CHARS=2000000
MAX_CHAT_MESSAGE_CHARS=2000
MAX_RETRIEVAL_PAGES=3
MAX_CONTEXT_CHARS=6000
RATE_LIMIT_PER_MINUTE=60
RATE_LIMIT_AUTH_PER_MINUTE=20
