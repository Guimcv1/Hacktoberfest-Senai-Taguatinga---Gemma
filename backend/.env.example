# Ambiente: development | test | production
ENVIRONMENT=development
# DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO

# Obrigatório. Segredo para assinar JWT: aleatório, exclusivo e com 32+ caracteres.
# Gere com: python -c "import secrets; print(secrets.token_urlsafe(48))"
# A API não inicia enquanto este valor estiver vazio.
JWT_SECRET=
JWT_EXPIRES_MINUTES=480

# Banco local (padrão SQLite para desenvolvimento). A implantação Docker usa PostgreSQL.
# DATABASE_URL=postgresql+psycopg2://studybuddy:studybuddy@localhost:5432/studybuddy
DATABASE_URL=sqlite:///./data/studybuddy.db

# Aplica as migrações Alembic ao iniciar a API. Com vários processos em produção,
# use false e rode "alembic upgrade head" uma única vez antes de subir a API.
DB_AUTO_MIGRATE=true

# Origens permitidas no CORS, separadas por vírgula.
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173

# URL base do Ollama que executa o Gemma (somente backend; nunca envie ao frontend).
# Ex.: http://localhost:11434 ou a URL atual do túnel informada pela equipe de IA.
# Não versione a URL real: um Ollama sem autenticação fica aberto a quem a conhecer.
AI_BASE_URL=
# Tag oficial: https://ollama.com/library/gemma4:e4b  (não é gemma4 nem gemma3:4b)
# Instale no Ollama com: ollama pull gemma4:e4b
# A API não baixa o modelo ao iniciar.
AI_MODEL=gemma4:e4b
# Tempo máximo de espera da resposta HTTP do modelo (não é o descarregamento da memória).
AI_TIMEOUT_SECONDS=120
# Quanto tempo o Ollama mantém o Gemma 4 E4B na RAM após a última resposta. 120s = 2 minutos.
# Cada POST /api/chat reinicia esse prazo. 0 descarrega logo após a resposta; -1 mantém até o Ollama reiniciar.
# Conversas e documentos no banco não são apagados quando o modelo sai da memória.
OLLAMA_KEEP_ALIVE=120s

# PDFs originais (além do texto extraído no banco). No Docker: /data/documents
DOCUMENT_STORAGE_DIR=./data/documents

MAX_PDF_SIZE_MB=10
MAX_PDF_PAGES=50
# Tempo de vida de cada documento (e das conversas dele). 10080 = 7 dias.
DOCUMENT_TTL_MINUTES=10080
# Limites por usuário: quantidade de documentos e total de caracteres extraídos.
MAX_STORED_DOCUMENTS=50
MAX_STORED_TEXT_CHARS=2000000
MAX_CHAT_MESSAGE_CHARS=2000
MAX_RETRIEVAL_PAGES=3
MAX_CONTEXT_CHARS=6000
# Requisições por minuto por IP (0 desativa). Login e cadastro têm limite próprio.
RATE_LIMIT_PER_MINUTE=60
RATE_LIMIT_AUTH_PER_MINUTE=20

# --- Docker Compose (copie este arquivo para .env e preencha os segredos) ---
# JWT_SECRET precisa ter 32+ caracteres e NÃO ser o exemplo público do README.
POSTGRES_USER=studybuddy
POSTGRES_PASSWORD=altere-esta-senha-localmente
POSTGRES_DB=studybuddy
PUBLISH_PORT=8080
# Contextos de build. Padrão: branches no GitHub.
# BACKEND_CONTEXT=.
# FRONTEND_CONTEXT=https://github.com/Guimcv1/Hacktoberfest-Senai-Taguatinga---Gemma.git#frontend:frontend
# OLLAMA_IMAGE=ollama/ollama:0.40.11
