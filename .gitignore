# --- Secrets and Environment Files ---
.env
.env.*
!.env.example
docker-compose.override.yml
*.pem
*.key

# --- Python ---
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
*.egg
.pytest_cache/
.mypy_cache/
.ruff_cache/
.tox/
.nox/
.hypothesis/
.coverage
.coverage.*
coverage.xml
htmlcov/
.python-version

# Python Virtual Environments
.venv/
venv/
env/
ENV/

# --- Node / Frontend ---
node_modules/
dist/
build/
.npm/
.eslintcache/
.stylelintcache/
*.tsbuildinfo
.vite/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# --- Local Databases and Storage ---
data/
uploads/
*.db
*.db-journal
*.db-wal
*.db-shm
*.sqlite
*.sqlite3

# --- OS and Editor files ---
.DS_Store
Thumbs.db
.idea/
.vscode/
*.sublime-*
*.swp
*.swo

# --- Logs and Runtime ---
*.log
logs/
pids/
*.pid
*.seed
*.pid.lock
tmp/
temp/
